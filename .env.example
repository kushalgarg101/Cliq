# The supplied candidate zip. Copy it to data/ or set this absolute path locally.
DATA_PACK_ZIP=
APP_ENV=demo
APP_COOKIE_SECURE=false
# Generic OpenAI-compatible LLM configuration. The key belongs to the selected provider.
LLM_MODE=provider
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Choose a model returned by your provider's live catalogue that supports tools.
# This was a verified OpenRouter free option at assessment setup time.
LLM_MODEL=google/gemma-4-26b-a4b-it:free
# Optional compatibility alias. LLM_API_KEY takes precedence.
OPENAI_API_KEY=
# Optional OpenRouter application attribution. Replace for other compatible providers as needed.
LLM_EXTRA_HEADERS_JSON={"HTTP-Referer":"http://127.0.0.1:8000","X-OpenRouter-Title":"ParcelPilot Support Agent"}
